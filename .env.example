# Copy this file to `.env` (git-ignored) and fill in local, non-production
# values. Wrangler auto-loads `.env` from the directory it is run in (the repo
# root for `pnpm dev:api`) and the value below overrides the development
# `localConnectionString` in `packages/api/wrangler.toml`.
#
# Use the dedicated development database (or a local Postgres). Never put
# staging/production credentials or real client data in this file.
#
# The API Worker reads the Hyperdrive binding below.
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://user:password@host:5432/taxdesk_development
#
# The migration runner (`pnpm db:migrate`, `pnpm db:migrate:status`) reads
# DATABASE_URL. `.env` and `.env.local` are loaded automatically; an explicit
# shell value or `--database-url` always wins. Use `sslmode=disable` only for a
# local, non-TLS Postgres.
# DATABASE_URL=postgres://taxdesk:taxdesk@localhost:5432/taxdesk_development?sslmode=disable
