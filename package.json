{
  "name": "taxdesk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter @taxdesk/database run migrate up",
    "db:migrate:status": "pnpm --filter @taxdesk/database run migrate status",
    "db:migrate:verify": "pnpm --filter @taxdesk/database run migrate verify",
    "db:migrate:manifest": "pnpm --filter @taxdesk/database run migrate manifest",
    "test:migrations": "pnpm --filter @taxdesk/database run test -- src/migrations/migrations.integration.test.ts",
    "ci:secrets": "pnpm --filter @taxdesk/platform run secrets",
    "ci:workflows": "pnpm --filter @taxdesk/platform run workflows",
    "ci:config-posture": "pnpm --filter @taxdesk/platform run config-posture",
    "ci:selftest": "pnpm --filter @taxdesk/platform run selftest",
    "ci:staging-smoke": "pnpm --filter @taxdesk/platform run smoke",
    "ci:db-posture": "pnpm --filter @taxdesk/platform run db-posture",
    "ci:backup-check": "pnpm --filter @taxdesk/platform run backup-check",
    "spike:onedrive": "pnpm --filter @taxdesk/onedrive-spike run spike",
    "dev:api": "wrangler dev --config packages/api/wrangler.toml",
    "dev:web": "pnpm --filter @taxdesk/web dev",
    "deploy:api:staging": "wrangler deploy --config packages/api/wrangler.toml --env staging",
    "deploy:api:production": "wrangler deploy --config packages/api/wrangler.toml --env production",
    "deploy:web:staging": "pnpm --filter @taxdesk/web build && pnpm --filter @taxdesk/web exec wrangler pages deploy dist --project-name taxdesk-web-staging --branch staging",
    "deploy:web:production": "pnpm --filter @taxdesk/web build && pnpm --filter @taxdesk/web exec wrangler pages deploy dist --project-name taxdesk-web-production --branch main",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm db:migrate:verify && pnpm ci:secrets && pnpm ci:workflows && pnpm ci:config-posture && pnpm ci:selftest && pnpm build",
    "auth:bootstrap": "pnpm --filter @taxdesk/api run auth:bootstrap",
    "auth:recover": "pnpm --filter @taxdesk/api run auth:recover",
    "test:api-db": "pnpm --filter @taxdesk/api run test -- src/repositories/postgres.integration.test.ts src/repositories/postgres-documents.integration.test.ts src/repositories/postgres-billing.integration.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-boundaries": "^4.2.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8",
    "wrangler": "^4.156.0"
  }
}
